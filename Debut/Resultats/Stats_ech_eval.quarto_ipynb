      "source": [
        "print(f\"Nombre de poissons : {len(df_final)}\")\n",
        "print(f\"Nombre d'échographies transversales : {len(df_cavite)}\")\n",
        "print(f\"Nombre d'écho transversales moyennes par poisson : {len(df_cavite)/len(df_final):.2f}\")\n",
        "print(f\"Nombre d'échographies longitudinales : {len(df_oeufs)} (dont {df_oeufs_individuels_pred['image_id'].nunique()} non vides)\")\n",
        "print(f\"Nombre d'oeufs : {len(df_oeufs_individuels_pred)}\")"
      ],
