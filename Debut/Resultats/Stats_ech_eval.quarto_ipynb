{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Résultats sur l'échantillon d'évaluation\"\n",
        "format: \n",
        "    html :\n",
        "        page-layout: full\n",
        "jupyter: python3\n",
        "execute:\n",
        "  echo: false\n",
        "---"
      ],
      "id": "049ac45f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# -------- 1. Importation des pakages nécessaires --------\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "import sys\n",
        "import matplotlib.pyplot as plt\n",
        "import statsmodels.api as sm\n",
        "import seaborn as sns\n",
        "\n",
        "sys.path.append(str(Path.cwd().parent))\n",
        "\n",
        "from utils.calcul_volume_fct import calculate_volumes, calculate_eggs_volumes, calculate_eggs_areas\n",
        "from utils.stats_fct import distribution, nuage_points, linear_regression, plot_evolution_curves"
      ],
      "id": "7dc9a64c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# -------- 2. Importation du fichier avec les metadatas --------\n",
        "file_path = '../utils/correspondance_echo_final.xlsx'\n",
        "df = pd.read_excel(file_path, dtype={\"image_id\": str})\n",
        "unique_id = np.unique(df.cap_id)"
      ],
      "id": "b90e83b8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: false\n",
        "\n",
        "# -------- 3. Récupère le volume réel et prédit des gonades et des oeufs de l'échantillon d'évaluation--------\n",
        "cavite_true_root = \"data/labels/YOLO/cavite\"\n",
        "cavite_pred_root = \"UNet/masks/eval/UNet/3classes\"\n",
        "eggs_true_root = \"data/labels/YOLO/oeufs\"\n",
        "eggs_pred_root = \"YOLO26/masks/eval/instance/oeufs\"\n",
        "\n",
        "resultats_cavite_true = []\n",
        "resultats_cavite_pred = []\n",
        "resultats_oeufs_true = []\n",
        "resultats_oeufs_pred = []\n",
        "\n",
        "# --- Calcul des volumes par poisson ----\n",
        "for id in unique_id:\n",
        "    # On récupère les échographies associées au poisson\n",
        "    echos_poisson = df[df.cap_id == id]\n",
        "\n",
        "    res_cavite_pred = calculate_volumes(\n",
        "        echos_poisson, id, f\"{cavite_pred_root}/pred_\"\n",
        "    )\n",
        "    res_cavite_true = calculate_volumes(\n",
        "        echos_poisson, id, f\"{cavite_true_root}/\"\n",
        "    )\n",
        "    res_oeufs_true, _ = calculate_eggs_volumes(\n",
        "        echos_poisson, id, f\"{eggs_true_root}/\"\n",
        "    )\n",
        "    res_oeufs_pred, _ = calculate_eggs_volumes(\n",
        "        echos_poisson, id, f\"{eggs_pred_root}/pred_\"\n",
        "    )\n",
        "\n",
        "    resultats_cavite_true.append(pd.DataFrame(res_cavite_true))\n",
        "    resultats_cavite_pred.append(pd.DataFrame(res_cavite_pred))\n",
        "    resultats_oeufs_pred.append(pd.DataFrame(res_oeufs_pred))\n",
        "    resultats_oeufs_true.append(pd.DataFrame(res_oeufs_true))\n",
        "\n",
        "# On fusionne tous les résultats en un seul DataFrame final\n",
        "df_res_pred = pd.concat(resultats_cavite_pred + resultats_oeufs_pred, ignore_index=True)\n",
        "df_res_true = pd.concat(resultats_cavite_true + resultats_oeufs_true, ignore_index=True)\n",
        "df_res_pred = df_res_pred.sort_values(by=['id poisson', 'position echo'])\n",
        "df_res_true = df_res_true.sort_values(by=['id poisson', 'position echo'])"
      ],
      "id": "735b32a5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df_res = pd.merge(df_res_pred, df_res_true, on=[\"id poisson\", \"image_id\", \"position echo\", \"echelle\"], suffixes=(\"_pred\", \"_true\"), how = \"left\")\n",
        "\n",
        "df_res.to_csv(\"volumes_ech_evaluation.csv\", index=False) # Sauvegarde du DataFrame en CSV"
      ],
      "id": "ad0ed689",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ------- 4. Récupération du volume individuel (non agrégé) de chaque œuf avec son échographie d'origine -------\n",
        "oeufs_individuels_pred = []\n",
        "oeufs_individuels_true = []\n",
        "df_echos_oeufs = df[df[\"type_image\"] == \"œufs\"]\n",
        "\n",
        "for _, echo in df_echos_oeufs.iterrows():\n",
        "    mask_pred_path = Path(\"..\") / eggs_pred_root / f\"pred_{echo['new_name_file']}.txt\"\n",
        "    mask_true_path = Path(\"../data/labels/YOLO/oeufs\") / f\"{echo['new_name_file']}.txt\"\n",
        "    image_path = Path(\"../data/images/oeufs\") / f\"{echo['new_name_file']}.jpg\"\n",
        "\n",
        "    if not mask_pred_path.exists() or not mask_true_path.exists() or not image_path.exists() or pd.isna(echo[\"echelle\"]):\n",
        "        continue\n",
        "\n",
        "    _, surfaces_oeufs_mm2_pred = calculate_eggs_areas(\n",
        "        str(mask_pred_path), str(image_path), echo[\"echelle\"]\n",
        "    )\n",
        "    _, surfaces_oeufs_mm2_true = calculate_eggs_areas(\n",
        "        str(mask_true_path), str(image_path), echo[\"echelle\"]\n",
        "    )\n",
        "\n",
        "    for surface_oeuf_mm2 in surfaces_oeufs_mm2_pred:\n",
        "        if surface_oeuf_mm2 <= 0:\n",
        "            continue\n",
        "        rayon_oeuf_mm = np.sqrt(surface_oeuf_mm2 / np.pi)\n",
        "        volume_oeuf_mm3 = 4 / 3 * np.pi * rayon_oeuf_mm ** 3\n",
        "        oeufs_individuels_pred.append({\n",
        "            \"id poisson\": str(echo[\"cap_id\"]),\n",
        "            \"image_id\": str(echo[\"image_id\"]),\n",
        "            \"volume_oeuf_mm3\": volume_oeuf_mm3,\n",
        "        })\n",
        "    \n",
        "    for surface_oeuf_mm2 in surfaces_oeufs_mm2_true:\n",
        "        if surface_oeuf_mm2 <= 0:\n",
        "            continue\n",
        "        rayon_oeuf_mm = np.sqrt(surface_oeuf_mm2 / np.pi)\n",
        "        volume_oeuf_mm3 = 4 / 3 * np.pi * rayon_oeuf_mm ** 3\n",
        "        oeufs_individuels_true.append({\n",
        "            \"id poisson\": str(echo[\"cap_id\"]),\n",
        "            \"image_id\": str(echo[\"image_id\"]),\n",
        "            \"volume_oeuf_mm3\": volume_oeuf_mm3,\n",
        "        })\n",
        "\n",
        "df_oeufs_individuels_true = pd.DataFrame(oeufs_individuels_true)\n",
        "df_oeufs_individuels_pred = pd.DataFrame(oeufs_individuels_pred)\n",
        "\n",
        "df_oeufs_individuels = pd.merge(\n",
        "    df_oeufs_individuels_pred, \n",
        "    df_oeufs_individuels_true, \n",
        "    on=[\"id poisson\", \"image_id\"], \n",
        "    suffixes=(\"_pred\", \"_true\"), \n",
        "    how=\"inner\"\n",
        ")"
      ],
      "id": "fe1494f9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# -------- 5. Fusionne les données des échographies avec celles des poissons et calcule la fécondité --------\n",
        "# ----- 5.1. Fusionne les données des échographies avec celles des poissons ----\n",
        "df_res[\"id poisson\"] = df_res[\"id poisson\"].astype(str)\n",
        "df_res = pd.merge(df_res, df[[ \"image_id\", \"poids_poisson\", \"long_poisson\", \"age_poisson\" ]], on=\"image_id\", how=\"left\")\n",
        "\n",
        "\n",
        "# ----- 5.2. Divise les données entre les cavités et les œufs ----\n",
        "df_cavite = df_res[df_res[\"position echo\"] != \"œufs\"]\n",
        "df_oeufs = df_res[df_res[\"position echo\"] == \"œufs\"]\n",
        "\n",
        "# ----- 5.3. Divise les données selon la position de l'écho ----\n",
        "df_debut = df_cavite[df_cavite['position echo'] < 2]\n",
        "df_fin = df_cavite[df_cavite['position echo'] >= 2]\n",
        "\n",
        "# ----- 5.4. Jeu de données final avec uniquement les volumes  -----\n",
        "df_final = df_res[[\"id poisson\", \"image_id\" , \"echelle\", \"volume_cavite_pred\", \"volume_gonade_pred\", \"volume_moyen_oeufs_mm3_pred\", \"volume_cavite_true\", \"volume_gonade_true\",\"volume_moyen_oeufs_mm3_true\", \"poids_poisson\", \"long_poisson\", \"age_poisson\"]].groupby('id poisson', as_index=False).last()\n",
        "df_final = df_final.dropna(subset=[\"volume_cavite_pred\"])\n",
        "\n",
        "#------ 5.5. Calcul et ajout de la fécondité -------\n",
        "df_final[\"fecondite_pred\"] = np.where(df_final[\"volume_moyen_oeufs_mm3_pred\"] != 0,\n",
        "    (df_final[\"volume_gonade_pred\"] * 1000) / df_final[\"volume_moyen_oeufs_mm3_pred\"], \n",
        "    np.nan\n",
        ")\n",
        "df_final[\"fecondite_true\"] = np.where(df_final[\"volume_moyen_oeufs_mm3_true\"] != 0,\n",
        "    (df_final[\"volume_gonade_true\"] * 1000) / df_final[\"volume_moyen_oeufs_mm3_true\"], \n",
        "    np.nan\n",
        ")"
      ],
      "id": "0f26570f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# -------- 6. Division des données --------\n",
        "poisson_counts = df_cavite['id poisson'].value_counts() # Nombre d'échographies par poisson\n",
        "\n",
        "# Filtrer les poissons avec plus de 2 lignes\n",
        "poissons_other = poisson_counts[poisson_counts > 2].index\n",
        "df_other = df_cavite[df_cavite['id poisson'].isin(poissons_other)]"
      ],
      "id": "79ba0b11",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Rappels échantillon de validation\n",
        "\n",
        ":::: {.columns}\n",
        "\n",
        "::: {.column width=\"50%\"}\n",
        "#### Vrai annotations"
      ],
      "id": "fabc0fbb"
    },
    {
      "cell_type": "code",
