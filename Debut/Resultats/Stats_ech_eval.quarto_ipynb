      "source": [
        "plot_evolution_curves(df_other, var1 = \"augmentation_surface_gonade_true\", var2 = \"augmentation_surface_cavite_true\")"
      ],
      "id": "7a1d2094",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Vérification des surfaces des gonades et de la cavité - Prédictions"
      ],
      "id": "ea819730"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plot_evolution_curves(df_other, var1 = \"augmentation_surface_gonade_pred\", var2 = \"augmentation_surface_cavite_pred\")"
      ],
      "id": "dbf9c843",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Détection des anomalies selon l'augmentation de la surface"
      ],
      "id": "d8c5b319"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "for id in df_cavite['id poisson'].unique():\n",
        "    rows = df_cavite[df_cavite['id poisson'] == id]\n",
        "    nb_rows = len(rows)\n",
        "    pb_list_pred = []\n",
        "    pb_list_true = []\n",
        "\n",
        "    # Détection des potentiels problèmes de surfaces pour des poissons avec plus de 2 échos\n",
        "    if nb_rows > 2:\n",
        "        for i in range(nb_rows):\n",
        "            # Si l'écho est à Op+2, alors elle ne doit pas avoir une augmentation négative de la surface des gonades\n",
        "            if rows.iloc[i][\"position echo\"]==2.0:\n",
        "                value_pred = rows.iloc[i].augmentation_surface_gonade_pred\n",
        "                value_true = rows.iloc[i].augmentation_surface_gonade_true\n",
        "                if value_pred < -10 : # Tolerance de 10% pour les diminutions de surface des gonades\n",
        "                    pb_list_pred.append(1)\n",
        "                else:\n",
        "                    pb_list_pred.append(0)\n",
        "                if value_true < -10 : # Tolerance de 10% pour les diminutions de surface des gonades\n",
        "                    pb_list_true.append(1)\n",
        "                else:\n",
        "                    pb_list_true.append(0)\n",
        "\n",
        "            # Si l'écho est à Op+3 ou plus, alors elle ne doit pas avoir une augmentation de la surface des gonades supérieure à 10%\n",
        "            elif rows.iloc[i][\"position echo\"]>2.0:\n",
        "                value_pred = rows.iloc[i].augmentation_surface_gonade_pred\n",
        "                value_true = rows.iloc[i].augmentation_surface_gonade_true\n",
        "                if value_pred > 10 : # Tolerance de 10% pour les augmentations de surface des gonades\n",
        "                    pb_list_pred.append(1)\n",
        "                else:\n",
        "                    pb_list_pred.append(0)\n",
        "                if value_true > 10 : # Tolerance de 10% pour les augmentations de surface des gonades\n",
        "                    pb_list_true.append(1)\n",
        "                else:\n",
        "                    pb_list_true.append(0)\n",
        "            else:\n",
        "                pb_list_pred.append(0)\n",
        "                pb_list_true.append(0)\n",
        "\n",
        "\n",
        "        for i in range(len(pb_list_pred)-1):\n",
        "            # Si il y a deux \"1\" à la suite, alors l'erreur est sur la première échographie où il y a un \"1\"\n",
        "            if pb_list_pred[i] == 1 and pb_list_pred[i+1] == 1:\n",
        "                print(f\"Pred - Poisson : {id} - Problèmes : {pb_list_pred}\")\n",
        "                print(f\"Pred - Poisson : {id} - Problème sur l'écho à la position {rows.iloc[i]['position echo']} (diminution surface gonade : {rows.iloc[i]['augmentation_surface_gonade_pred']}%)\")\n",
        "\n",
        "            if pb_list_true[i] == 1 and pb_list_true[i+1] == 1:\n",
        "                print(f\"True - Poisson : {id} - Problèmes : {pb_list_true}\")\n",
        "                print(f\"True - Poisson : {id} - Problème sur l'écho à la position {rows.iloc[i]['position echo']} (diminution surface gonade : {rows.iloc[i]['augmentation_surface_gonade_true']}%)\")\n",
        "        # Si il y a un \"1\" seul à la deuxième position, alors l'erreur est sur la première échographie\n",
        "        if pb_list_pred[1] == 1 and pb_list_pred[0] == 0 and pb_list_pred[2] == 0:\n",
        "            print(f\"Pred - Poisson : {id} - Problèmes : {pb_list_pred}\")\n",
        "            print(f\"pred - Poisson : {id} - Problème sur l'écho à la position {rows.iloc[0]['position echo']} (diminution surface gonade : {rows.iloc[0]['augmentation_surface_gonade_pred']}%)\")\n",
        "\n",
        "        if pb_list_true[1] == 1 and pb_list_true[0] == 0 and pb_list_true[2] == 0:\n",
        "            print(f\"True - Poisson : {id} - Problèmes : {pb_list_true}\")\n",
        "            print(f\"True - Poisson : {id} - Problème sur l'écho à la position {rows.iloc[0]['position echo']} (diminution surface gonade : {rows.iloc[0]['augmentation_surface_gonade_true']}%)\")"
      ],
      "id": "e8fdf14c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Relations entre surfaces des gonades et de la cavité - Annotations"
      ],
      "id": "3f9e566a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "\n",
        "nuage_points(\n",
        "    x=df_cavite.surface_cavite_true, \n",
        "    y=df_cavite.surface_gonade_true,\n",
        "    color_var=df_cavite['position echo'],  # Utilisation de la variable 'position echo' pour colorier les points\n",
        "    titre=\"Relation surfaces cavité / gonades\", \n",
        "    xlabel=\"Surface de la cavité\", \n",
        "    ylabel=\"Surface des gonades\",\n",
        "    couleur='teal',\n",
        "    ax=axes[0]\n",
        "    )\n",
        "\n",
        "nuage_points(\n",
        "    x=df_fin.surface_cavite_true, \n",
        "    y=df_fin.surface_gonade_true,\n",
        "    color_var=df_fin['position echo'],  # Utilisation de la variable 'position echo' pour colorier les points\n",
        "    titre=\"Relation surfaces cavité / gonades (pour position echo >= 2)\", \n",
        "    xlabel=\"Surface de la cavité (en cm2)\", \n",
        "    ylabel=\"Surface des gonades (en cm2)\",\n",
        "    couleur='teal',\n",
        "    ax=axes[1]\n",
        "    )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(f\"Corrélation : {df_cavite.surface_cavite_true.corr(df_cavite.surface_gonade_true):.2f}\")\n",
        "print(f\"Corrélation (pour position echo >= 2) : {df_fin.surface_cavite_true.corr(df_fin.surface_gonade_true):.2f}\")"
      ],
      "id": "650c6a9c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Relations entre surfaces des gonades et de la cavité - Prédictions"
      ],
      "id": "47d7b2fb"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "\n",
        "nuage_points(\n",
        "    x=df_cavite.surface_cavite_pred, \n",
        "    y=df_cavite.surface_gonade_pred,\n",
        "    color_var=df_cavite['position echo'],  # Utilisation de la variable 'position echo' pour colorier les points\n",
        "    titre=\"Relation surfaces cavité / gonades\", \n",
        "    xlabel=\"Surface de la cavité\", \n",
        "    ylabel=\"Surface des gonades\",\n",
        "    couleur='teal',\n",
        "    ax=axes[0]\n",
        "    )\n",
        "\n",
        "nuage_points(\n",
        "    x=df_fin.surface_cavite_pred, \n",
        "    y=df_fin.surface_gonade_pred,\n",
        "    color_var=df_fin['position echo'],  # Utilisation de la variable 'position echo' pour colorier les points\n",
        "    titre=\"Relation surfaces cavité / gonades (pour position echo >= 2)\", \n",
        "    xlabel=\"Surface de la cavité (en cm2)\", \n",
        "    ylabel=\"Surface des gonades (en cm2)\",\n",
        "    couleur='teal',\n",
        "    ax=axes[1]\n",
        "    )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(f\"Corrélation : {df_cavite.surface_cavite_pred.corr(df_cavite.surface_gonade_pred):.2f}\")\n",
        "print(f\"Corrélation (pour position echo >= 2) : {df_fin.surface_cavite_pred.corr(df_fin.surface_gonade_pred):.2f}\")"
      ],
