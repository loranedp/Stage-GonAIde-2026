      "source": [
        "# ------------ Calcul du volume des oeufs ------------\n",
        "# Distribution des volumes individuels des œufs pour chaque échographie\n",
        "ordre_images_true = sorted(df_oeufs_individuels_true[\"image_id\"].unique())\n",
        "ordre_images_pred = sorted(df_oeufs_individuels_pred[\"image_id\"].unique())\n",
        "ordre_poissons_true = sorted(df_oeufs_individuels_true[\"id poisson\"].unique())\n",
        "ordre_poissons_pred = sorted(df_oeufs_individuels_pred[\"id poisson\"].unique())\n",
        "palette_poissons_true = dict(zip(\n",
        "    ordre_poissons_true, sns.color_palette(\"Set2\", n_colors=len(ordre_poissons_true))\n",
        "))\n",
        "palette_poissons_pred = dict(zip(\n",
        "    ordre_poissons_pred, sns.color_palette(\"Set2\", n_colors=len(ordre_poissons_pred))\n",
        "))\n",
        "\n",
        "# Identification des œufs extrêmes selon la règle du boxplot, par échographie\n",
        "df_oeufs_individuels_extremes_true = df_oeufs_individuels_true.copy()\n",
        "df_oeufs_individuels_extremes_pred = df_oeufs_individuels_pred.copy()\n",
        "volumes_par_image_true = df_oeufs_individuels_extremes_true.groupby(\"image_id\")[\"volume_oeuf_mm3\"]\n",
        "volume_par_image_pred = df_oeufs_individuels_extremes_pred.groupby(\"image_id\")[\"volume_oeuf_mm3\"]\n",
        "\n",
        "q1_true = volumes_par_image_true.transform(lambda volumes: volumes.quantile(0.25))\n",
        "q1_pred = volume_par_image_pred.transform(lambda volumes: volumes.quantile(0.25))\n",
        "q3_true = volumes_par_image_true.transform(lambda volumes: volumes.quantile(0.75))\n",
        "q3_pred = volume_par_image_pred.transform(lambda volumes: volumes.quantile(0.75))\n",
        "iqr_true = q3_true - q1_true\n",
        "iqr_pred = q3_pred - q1_pred\n",
        "df_oeufs_individuels_extremes_true[\"extreme_inferieur\"] = (\n",
        "    df_oeufs_individuels_extremes_true[\"volume_oeuf_mm3\"] < q1_true - 1.5 * iqr_true\n",
        ")\n",
        "df_oeufs_individuels_extremes_true[\"extreme_superieur\"] = (\n",
        "    df_oeufs_individuels_extremes_true[\"volume_oeuf_mm3\"] > q3_true + 1.5 * iqr_true\n",
        ")\n",
        "df_oeufs_individuels_extremes_pred[\"extreme_inferieur\"] = (\n",
        "    df_oeufs_individuels_extremes_pred[\"volume_oeuf_mm3\"] < q1_pred - 1.5 * iqr_pred\n",
        ")\n",
        "df_oeufs_individuels_extremes_pred[\"extreme_superieur\"] = (\n",
        "    df_oeufs_individuels_extremes_pred[\"volume_oeuf_mm3\"] > q3_pred + 1.5 * iqr_pred\n",
        ")\n",
        "\n",
        "resume_extremes_true = (\n",
        "    df_oeufs_individuels_extremes_true.groupby(\"image_id\")\n",
        "    .agg(\n",
        "        nombre_oeufs=(\"volume_oeuf_mm3\", \"size\"),\n",
        "        nombre_extremes_inferieurs=(\"extreme_inferieur\", \"sum\"),\n",
        "        nombre_extremes_superieurs=(\"extreme_superieur\", \"sum\"),\n",
        "    )\n",
        "    .reindex(ordre_images_true)\n",
        ")\n",
        "resume_extremes_pred = (\n",
        "    df_oeufs_individuels_extremes_pred.groupby(\"image_id\")\n",
        "    .agg(\n",
        "        nombre_oeufs=(\"volume_oeuf_mm3\", \"size\"),\n",
        "        nombre_extremes_inferieurs=(\"extreme_inferieur\", \"sum\"),\n",
        "        nombre_extremes_superieurs=(\"extreme_superieur\", \"sum\"),\n",
        "    )\n",
        "    .reindex(ordre_images_pred)\n",
        ")\n",
        "resume_extremes_true[\"proportion_extremes_inferieurs\"] = (\n",
        "    100 * resume_extremes_true[\"nombre_extremes_inferieurs\"] / resume_extremes_true[\"nombre_oeufs\"]\n",
        ")\n",
        "resume_extremes_true[\"proportion_extremes_superieurs\"] = (\n",
        "    100 * resume_extremes_true[\"nombre_extremes_superieurs\"] / resume_extremes_true[\"nombre_oeufs\"]\n",
        ")\n",
        "\n",
        "resume_extremes_pred[\"proportion_extremes_inferieurs\"] = (\n",
        "    100 * resume_extremes_pred[\"nombre_extremes_inferieurs\"] / resume_extremes_pred[\"nombre_oeufs\"]\n",
        ")\n",
        "resume_extremes_pred[\"proportion_extremes_superieurs\"] = (\n",
        "    100 * resume_extremes_pred[\"nombre_extremes_superieurs\"] / resume_extremes_pred[\"nombre_oeufs\"]\n",
        ")"
      ],
